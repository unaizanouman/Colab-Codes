        "%%writefile q2_hadoop.py\n",
        "from mrjob.job import MRJob\n",
        "\n",
        "class MRWeatherAvg(MRJob):\n",
        "    def mapper(self, _, line):\n",
        "        if \"Date\" in line: return # Skip header\n",
        "        row = line.split(',')\n",
        "        yield row[0], float(row[1]) # Yield Date, Temp\n",
        "\n",
        "    def reducer(self, date, temps):\n",
        "        total = 0\n",
        "        count = 0\n",
        "        for t in temps:\n",
        "            total += t\n",
        "            count += 1\n",
        "        yield date, total / count\n",
        "\n",
        "if __name__ == '__main__':\n",
        "    MRWeatherAvg.run()"
      ],
