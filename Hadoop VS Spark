        "import threading\n",
        "import time\n",
        "import random\n",
        "import queue\n",
        "\n",
        "# --- CONFIGURATION ---\n",
        "cloud_server_storage = queue.Queue()\n",
        "\n",
        "# --- CLASSES ---\n",
        "class EdgeDevice(threading.Thread):\n",
        "    def __init__(self, device_id, sensor_type):\n",
        "        threading.Thread.__init__(self)\n",
        "        self.device_id = device_id\n",
        "        self.sensor_type = sensor_type\n",
        "\n",
        "    def run(self):\n",
        "        print(f\"[Edge Device {self.device_id}] collecting {self.sensor_type} data...\")\n",
        "\n",
        "        # Simulate data collection (5 readings)\n",
        "        readings = [random.uniform(20.0, 35.0) for _ in range(5)]\n",
        "        time.sleep(1) # Simulate processing time\n",
        "\n",
        "        # FOG LAYER: Process locally (Calculate Average)\n",
        "        avg_reading = sum(readings) / len(readings)\n",
        "\n",
        "        data_packet = {\n",
        "            \"id\": self.device_id,\n",
        "            \"type\": self.sensor_type,\n",
        "            \"avg_value\": round(avg_reading, 2)\n",
        "        }\n",
        "\n",
        "        # Forward to Cloud\n",
        "        print(f\" -> [Device {self.device_id}] Sending processed data to Cloud.\")\n",
        "        cloud_server_storage.put(data_packet)\n",
        "\n",
        "# --- MAIN EXECUTION ---\n",
        "# 1. Create Sensors\n",
        "sensors = [\n",
        "    EdgeDevice(101, \"Temperature\"),\n",
        "    EdgeDevice(102, \"Motion\"),\n",
        "    EdgeDevice(103, \"Humidity\"),\n",
        "    EdgeDevice(104, \"Temperature\")\n",
        "]\n",
        "\n",
        "# 2. Start Threads (Fog Layer)\n",
        "for s in sensors:\n",
        "    s.start()\n",
        "\n",
        "# 3. Wait for all devices to finish\n",
        "for s in sensors:\n",
        "    s.join()\n",
        "\n",
        "# 4. Cloud Server Output\n",
        "print(\"\\n--- CLOUD SERVER LOGS ---\")\n",
        "while not cloud_server_storage.empty():\n",
        "    packet = cloud_server_storage.get()\n",
        "    print(f\"☁️ STORED: Device {packet['id']} ({packet['type']}) : Value {packet['avg_value']}\")"
      ]
