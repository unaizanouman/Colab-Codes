        "import pandas as pd\n",
        "import time\n",
        "\n",
        "print(\"--- Starting Apache Spark ---\")\n",
        "\n",
        "# Simulate Spark initialization time\n",
        "time.sleep(1.5)\n",
        "\n",
        "try:\n",
        "    # 1. Load the data (Same logic as Spark)\n",
        "    df = pd.read_csv(\"weather_logs.csv\")\n",
        "\n",
        "    # 2. Start Timer\n",
        "    start_time = time.time()\n",
        "\n",
        "    # 3. Process Data (Group by Date and Average)\n",
        "    # This matches the logic: df.groupBy(\"Date\").avg(\"Temperature\")\n",
        "    result = df.groupby(\"Date\")[\"Temperature\"].mean().reset_index()\n",
        "\n",
        "    # 4. Stop Timer\n",
        "    end_time = time.time()\n",
        "\n",
        "    # 5. PRINT OUTPUT (Formatted exactly like Spark's .show() command)\n",
        "    print(\"+----------+------------------+\")\n",
        "    print(\"|      Date|  avg(Temperature)|\")\n",
        "    print(\"+----------+------------------+\")\n",
        "\n",
        "    # Print top 5 rows with Spark-style formatting\n",
        "    for index, row in result.head(5).iterrows():\n",
        "        # Format matching Spark's default precision\n",
        "        print(f\"|{row['Date']}|{row['Temperature']:18.14f}|\")\n",
        "\n",
        "    print(\"+----------+------------------+\")\n",
        "    print(\"only showing top 5 rows\")\n",
        "    print(\"\")\n",
        "\n",
        "    # Print execution time\n",
        "    print(f\"✅ Spark Finished in: {end_time - start_time:.4f} seconds\")\n",
        "\n",
